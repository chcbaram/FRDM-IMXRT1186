{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-G",
        "Ninja",
        "-DBUILD_CM7=ON"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build-build",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "-j8"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "build-configure",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build-clean",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "clean"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "flash-all",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "flash"
      ],
      "problemMatcher": [],
      "dependsOn": "build-build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "flash-cm33",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "flash-cm33"
      ],
      "problemMatcher": [],
      "dependsOn": "build-build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "flash-cm7",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "flash-cm7"
      ],
      "problemMatcher": [],
      "dependsOn": "build-build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "download-all",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/../rt1180-boot/tools/download.py",
        "--target",
        "all",
        "--port",
        "${input:downloadPort}"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build-build"
    },
    {
      "label": "download-cm33",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/../rt1180-boot/tools/download.py",
        "--target",
        "fw",
        "--port",
        "${input:downloadPort}"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build-build"
    },
    {
      "label": "download-cm7",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/../rt1180-boot/tools/download.py",
        "--target",
        "cm7",
        "--port",
        "${input:downloadPort}"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build-build"
    },
    {
      "label": "download-list",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/../rt1180-boot/tools/download.py",
        "--list"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "gdb-server",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/gdbserver.py",
        "start",
        "--pidfile",
        "${workspaceFolder}/build/probe-rs-gdb.pid"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "flash + gdb-server",
      "dependsOrder": "sequence",
      "dependsOn": [
        "flash-all",
        "gdb-server"
      ],
      "problemMatcher": []
    },
    {
      "label": "gdb-server-stop",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/gdbserver.py",
        "stop",
        "--pidfile",
        "${workspaceFolder}/build/probe-rs-gdb.pid"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ],
  "inputs": [
    {
      "id": "downloadPort",
      "type": "command",
      "command": "firmware-task.pickSerialPort",
      "args": {
        "placeholder": "MCU-Link VCOM 포트 (download.py --list 의 * 표시)"
      }
    }
  ]
}