{
  "folders": [
    {
      "name": "rt1180-fw (전체)",
      "path": "../"
    }
  ],
  "settings": {
    "C_Cpp.autoAddFileAssociations": false,
    "files.exclude": {
      "**/.DS_Store": true,
      "**/prj": true,
      "**/Thumbs.db": true
    },
    "search.exclude": {
      "**/build": true,
      "src/lib/nxp/devices/periph": true
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/cm33/compile_commands.json",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-arm"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build-configure",
        "type": "process",
        "command": "cmake",
        "args": [
          "-S",
          ".",
          "-B",
          "build",
          "-G",
          "Ninja",
          "-DBUILD_CM7=ON"
        ],
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      {
        "label": "build-build",
        "type": "process",
        "command": "cmake",
        "args": [
          "--build",
          "build",
          "-j8"
        ],
        "problemMatcher": [
          "$gcc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "dependsOn": "build-configure",
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      {
        "label": "build-clean",
        "type": "process",
        "command": "cmake",
        "args": [
          "--build",
          "build",
          "--target",
          "clean"
        ],
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      {
        "label": "flash",
        "type": "process",
        "command": "cmake",
        "args": [
          "--build",
          "build",
          "--target",
          "flash"
        ],
        "problemMatcher": [],
        "dependsOn": "build-build",
        "options": {
          "cwd": "${workspaceFolder}"
        }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Flash + Attach CM33 + CM7",
        "type": "probe-rs-debug",
        "request": "attach",
        "cwd": "${workspaceFolder}",
        "chip": "MIMXRT1186",
        "chipDescriptionPath": "${workspaceFolder}/tools/probe-rs/MIMXRT1186.yaml",
        "preLaunchTask": "flash",
        "coreConfigs": [
          {
            "coreIndex": 0,
            "programBinary": "${workspaceFolder}/build/cm33/rt1180-fw-cm33.elf",
            "svdFile": "${workspaceFolder}/tools/svd/MIMXRT1186_cm33.xml"
          },
          {
            "coreIndex": 1,
            "programBinary": "${workspaceFolder}/build/cm7/rt1180-fw-cm7.elf",
            "svdFile": "${workspaceFolder}/tools/svd/MIMXRT1186_cm7.xml"
          }
        ]
      },
      {
        "name": "Attach CM33 + CM7",
        "type": "probe-rs-debug",
        "request": "attach",
        "cwd": "${workspaceFolder}",
        "chip": "MIMXRT1186",
        "chipDescriptionPath": "${workspaceFolder}/tools/probe-rs/MIMXRT1186.yaml",
        "coreConfigs": [
          {
            "coreIndex": 0,
            "programBinary": "${workspaceFolder}/build/cm33/rt1180-fw-cm33.elf",
            "svdFile": "${workspaceFolder}/tools/svd/MIMXRT1186_cm33.xml"
          },
          {
            "coreIndex": 1,
            "programBinary": "${workspaceFolder}/build/cm7/rt1180-fw-cm7.elf",
            "svdFile": "${workspaceFolder}/tools/svd/MIMXRT1186_cm7.xml"
          }
        ]
      },
      {
        "name": "Attach CM33",
        "type": "probe-rs-debug",
        "request": "attach",
        "cwd": "${workspaceFolder}",
        "chip": "MIMXRT1186",
        "chipDescriptionPath": "${workspaceFolder}/tools/probe-rs/MIMXRT1186.yaml",
        "coreConfigs": [
          {
            "coreIndex": 0,
            "programBinary": "${workspaceFolder}/build/cm33/rt1180-fw-cm33.elf",
            "svdFile": "${workspaceFolder}/tools/svd/MIMXRT1186_cm33.xml"
          }
        ]
      },
      {
        "name": "Attach CM7",
        "type": "probe-rs-debug",
        "request": "attach",
        "cwd": "${workspaceFolder}",
        "chip": "MIMXRT1186",
        "chipDescriptionPath": "${workspaceFolder}/tools/probe-rs/MIMXRT1186.yaml",
        "coreConfigs": [
          {
            "coreIndex": 1,
            "programBinary": "${workspaceFolder}/build/cm7/rt1180-fw-cm7.elf",
            "svdFile": "${workspaceFolder}/tools/svd/MIMXRT1186_cm7.xml"
          }
        ]
      }
    ]
  }
}
